rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Customer accounts data - accessible for lookup, updates, and imports
    match /accounts/{accountId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    
    // Audit logs for tracking profile updates & rewards
    match /audit_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // App configurations (Google Sheets sync, custom Excel columns metadata & settings)
    match /app_config/{configId} {
      allow read, write: if true;
    }
  }
}

