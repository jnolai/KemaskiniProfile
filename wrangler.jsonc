{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kemaskiniprofile",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  }
}
